// Déploiement du portail Nora sur Cloudflare Workers (assets statiques uniquement, aucun code Worker).
//
// Ce fichier DOIT exister : sans lui, `wrangler deploy` détecte un projet Vite et tente de réécrire
// vite.config.ts pour y injecter @cloudflare/vite-plugin. Le Worker n'a pas de script — il n'y a
// rien à brancher, et ce fichier suffit à le dire.
//
// ⚠️ VITE_PORTAL_API_URL (et VITE_PORTAL_CACHE_TTL_SECONDS, facultative) sont inlinées par Vite à
// `npm run build` : elles se règlent comme variables de BUILD du projet Cloudflare
// (Settings → Build → Variables), jamais comme variables de runtime — un Worker sans code n'en a pas.
// Absentes, le build passe quand même et le portail ne joint aucune API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nora",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    // React Router (BrowserRouter) : toute route inconnue sert index.html au lieu d'un 404.
    "not_found_handling": "single-page-application"
  },

  // Le portail est multi-tenant PAR NOM D'HÔTE : `nantes.edilumen.fr` doit arriver ici sans qu'on
  // ait rien déployé pour Nantes. D'où une route générique plutôt qu'un domaine personnalisé —
  // ceux-ci n'acceptent pas de joker et demanderaient une entrée par collectivité.
  //
  // ⚠️ `*.edilumen.fr/*` capte AUSSI www, iris, socle et clara : sur un même nom d'hôte, une route
  // passe DEVANT un domaine personnalisé. Ces quatre-là sont donc exclus par des routes SANS Worker
  // (« None » dans le tableau de bord), plus spécifiques, qui annulent le joker et laissent la
  // requête arriver au Worker de chaque application. Ces exclusions ne peuvent pas vivre ici — un
  // fichier wrangler ne décrit que les routes DE CE Worker — elles se règlent au niveau de la zone.
  //
  // Ne jamais pousser ce fichier avant que ces exclusions existent : le build Cloudflare créerait
  // la route joker et les quatre applications serviraient le portail.
  //
  // L'apex `edilumen.fr` n'est pas concerné : `*.edilumen.fr/*` ne matche que les sous-domaines.
  "routes": [
    { "pattern": "*.edilumen.fr/*", "zone_name": "edilumen.fr" }
  ]
}
