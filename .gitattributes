# Normalise les fins de ligne : LF dans le dépôt et à l'extraction,
# quel que soit le système (évite le bruit CRLF/LF entre Windows et Linux).
* text=auto eol=lf

# Fichiers binaires : jamais de conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
